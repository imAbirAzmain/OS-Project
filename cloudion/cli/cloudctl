#!/usr/bin/env bash

# Path: mini_cloud/cli/cloudctl
PORT=8080
TOKEN="cloud_secret_123"
SERVER_BIN="bin/minicloud-server"
LOG_FILE="server.log"

case "$1" in
    # --- DEVOPS & PROCESS MANAGEMENT ---
    build)
        echo "[*] Compiling C Engine..."
        make
        ;;
    start)
        if pgrep -f "$SERVER_BIN" > /dev/null; then
            echo "[!] Stopping running server instance..."
            pkill -f "$SERVER_BIN" 2>/dev/null
            sleep 1
        fi
        echo "[*] Starting Mini Cloud Server on port $PORT..."
        ./$SERVER_BIN $PORT > $LOG_FILE 2>&1 &
        echo "[✔] Server running in background (PID: $!). Logs: $LOG_FILE"
        ;;
    stop)
        echo "[*] Shutting down Mini Cloud Server..."
        if pkill -f "$SERVER_BIN"; then
            echo "[✔] Server stopped."
        else
            echo "[!] No active server process found."
        fi
        ;;
    status)
        if pgrep -f "$SERVER_BIN" > /dev/null; then
            echo "[✔] Mini Cloud Server is RUNNING."
        else
            echo "[!] Mini Cloud Server is STOPPED."
        fi
        ;;

    # --- FILE MANAGEMENT WRAPPERS ---
    get)
        # Usage: ./cloudctl get /alice/hello.txt
        if [ -z "$2" ]; then
            echo "Usage: ./cloudctl get <remote_path>"
            exit 1
        fi
        curl -s -H "Authorization: Bearer $TOKEN" "http://localhost:$PORT$2"
        echo ""
        ;;
    put)
        # Usage: ./cloudctl put <local_file> <remote_path>
        if [ -z "$2" ] || [ -z "$3" ]; then
            echo "Usage: ./cloudctl put <local_file> <remote_path>"
            exit 1
        fi
        curl -s -X POST -H "Authorization: Bearer $TOKEN" --data-binary "@$2" "http://localhost:$PORT$3"
        echo ""
        ;;

    # --- SOCIAL ENGINE WRAPPERS ---
    friend)
        # Usage: ./cloudctl friend add alice bob
        if [ "$2" = "add" ] && [ -n "$3" ] && [ -n "$4" ]; then
            curl -s -X POST -H "Authorization: Bearer $TOKEN" "http://localhost:$PORT/social/add_friend?user=$3&friend=$4"
            echo ""
        else
            echo "Usage: ./cloudctl friend add <user> <friend>"
        fi
        ;;
    msg)
        # Usage: ./cloudctl msg alice bob "Hello!"
        if [ -z "$2" ] || [ -z "$3" ] || [ -z "$4" ]; then
            echo "Usage: ./cloudctl msg <from> <to> \"<message>\""
            exit 1
        fi
        curl -s -X POST -H "Authorization: Bearer $TOKEN" -d "$4" "http://localhost:$PORT/social/send?from=$2&to=$3"
        echo ""
        ;;
    inbox)
        # Usage: ./cloudctl inbox bob
        if [ -z "$2" ]; then
            echo "Usage: ./cloudctl inbox <user>"
            exit 1
        fi
        curl -s -H "Authorization: Bearer $TOKEN" "http://localhost:$PORT/social/inbox?user=$2"
        echo ""
        ;;

    *)
        echo "Mini Cloud Administrative CLI (cloudctl)"
        echo "Usage: ./cloudctl {build|start|stop|status|get|put|friend|msg|inbox}"
        exit 1
        ;;
esac
